# Copy to .dev.vars for local `cf dev` (never commit .dev.vars)
OWNER_TOKEN=dev-owner-token-change-me
JOIN_TOKEN=dev-join-token-change-me
# Optional: GitHub token for private release asset downloads
# GITHUB_TOKEN=ghp_...

# WorkOS Google-only auth (multi-organization, multi-user auth — one ControllerDO per org)
# WORKOS_CLIENT_ID=client_...
# WORKOS_API_KEY=sk_test_...
# WORKOS_COOKIE_PASSWORD=change-me-at-least-32-random-characters
# WORKOS_AUTH_PROVIDER=GoogleOAuth
# INITIAL_SIGNUP_CODE=LC2026051
# Optional: map an existing single-DO ("default") cluster to a specific WorkOS org ID
# DEFAULT_ORG_ID=org_...
